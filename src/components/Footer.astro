---

---

<footer id="contacto" class="relative flex min-h-svh flex-col justify-end overflow-hidden text-white">
  <img
    src="/footer-landscape.webp"
    alt=""
    width="1920"
    height="1080"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-top"
    aria-hidden="true"
  />

  <!-- Scrim: short white blend at top + stronger mid/bottom for white type -->
  <div
    class="absolute inset-0 bg-linear-to-b from-white from-0% via-white/80 via-8% to-transparent to-28%"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-linear-to-b from-transparent via-cod-gray-950/55 to-cod-gray-950/80 max-lg:via-cod-gray-950/65 max-lg:to-cod-gray-950/85"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 flex w-full flex-col gap-16 px-4 pt-28 pb-10 sm:px-6 lg:gap-20 lg:px-8 lg:pb-14">
    <!-- Centered CTA -->
    <div data-reveal class="mx-auto w-full max-w-3xl text-center">
      <h2
        class="mb-4 text-4xl font-extrabold tracking-tight text-balance text-white drop-shadow-sm sm:text-5xl lg:text-6xl"
      >
        Contacto: AVA Tours
      </h2>
      <p class="mb-3 text-xl font-bold text-balance text-white sm:text-2xl">
        ¡Contáctate con tu agencia de viajes aliada!
      </p>
      <p class="mx-auto mb-5 max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">
        Nuestra red de agencias está preparada para ayudarte a seleccionar el destino ideal,
        aprovechar las mejores ofertas de viajes y planificar unas vacaciones inolvidables con el
        respaldo de AVA Tours.
      </p>
      <p class="mb-8 text-sm text-white/70 sm:text-base">
        Lunes a Viernes, 8:30 a.m. – 5:30 p.m.
      </p>
      <a
        href="tel:+1-787-692-9896"
        class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-sm font-bold tracking-wide text-cod-gray-950 uppercase transition hover:bg-monza-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Llámanos
      </a>
    </div>

    <!-- Bottom columns + watermark -->
    <div class="relative mx-auto w-full max-w-7xl">
      <p
        class="pointer-events-none absolute inset-x-0 bottom-0 z-0 select-none text-center text-[clamp(4.5rem,18vw,12rem)] leading-none font-extrabold tracking-tighter text-white/10"
        aria-hidden="true"
      >
        AVA
      </p>

      <div class="relative z-10 flex flex-col items-center gap-10 text-center sm:flex-row sm:items-start sm:justify-between sm:gap-12 sm:text-left">
        <!-- Brand -->
        <div class="flex w-full flex-col items-center sm:max-w-sm sm:items-start">
          <p class="mb-3 text-2xl font-extrabold tracking-tight">AVA Tours</p>
          <p class="mb-5 max-w-xs text-sm leading-relaxed text-white/75">
            Mayoristas de viajes en Puerto Rico. Paquetes, cruceros y experiencias con el respaldo de
            nuestra red de agencias aliadas.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3 sm:justify-start">
            <a
              href="https://www.facebook.com/agenciasdeviajesaliadas"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-white/30 transition hover:border-monza-600 hover:bg-monza-600"
              aria-label="Facebook de AVA Tours"
            >
              <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M22 12a10 10 0 1 0-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12H17l-.4 3h-2.7v7A10 10 0 0 0 22 12z"
                ></path></svg
              >
            </a>
            <a
              href="https://www.instagram.com/a.v.a.tours/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-white/30 transition hover:border-monza-600 hover:bg-monza-600"
              aria-label="Instagram de AVA Tours"
            >
              <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm11 1.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                ></path></svg
              >
            </a>
            <a
              href="https://infopaginas.com/b/caguas/ava-tours"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center shrink-0 opacity-90 transition hover:opacity-100"
              aria-label="AVA Tours en Infopáginas"
            >
              <img
                src="/info-logo.svg"
                alt="Infopáginas"
                width="100"
                height="32"
                class="h-7 w-auto object-contain invert sm:h-8"
                decoding="async"
              />
            </a>
            <a
              href="https://www.google.com/search?q=ava+tours+puerto+rico#lrd=0x8c035bf60064534f:0x5a4786a79f54ba48,1"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center shrink-0 opacity-90 transition hover:opacity-100"
              aria-label="Google Reviews de AVA Tours"
            >
              <img
                src="/Google-Reviews-White.png"
                alt="Google Reviews"
                width="120"
                height="40"
                class="h-8 w-auto object-contain sm:h-9"
                decoding="async"
              />
            </a>
            <a
              href="https://infomediapr.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center shrink-0 opacity-90 transition hover:opacity-100"
              aria-label="Infomedia"
            >
              <img
                src="/infomedia-white.png"
                alt="Infomedia"
                width="120"
                height="32"
                class="h-7 w-auto object-contain sm:h-8"
                decoding="async"
              />
            </a>
          </div>
        </div>

        <!-- Contact details -->
        <div class="w-full sm:w-auto sm:text-right">
          <p class="mb-4 text-xs font-semibold tracking-[0.22em] text-white/55 uppercase">Contacto</p>
          <ul class="space-y-3 text-sm text-white/85">
            <li>
              <a href="tel:+1-787-692-9896" class="transition hover:text-white">+1-787-692-9896</a>
            </li>
            <li>
              <a
                href="mailto:avatoursmarketing@gmail.com"
                class="break-all transition hover:text-white"
              >
                avatoursmarketing@gmail.com
              </a>
            </li>
            <li class="pt-1 text-white/60">
              Licencia MVE-47 · Compañía de Turismo de Puerto Rico
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
