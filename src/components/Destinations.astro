---
import DottedMap from 'dotted-map';
import DestinationsPanel from './DestinationsPanel';

// Computed once at build time (not in the visitor's browser) so the dotted world map never
// blocks the main thread when the section scrolls into view.
const map = new DottedMap({
  height: 150,
  grid: 'diagonal',
  projection: { name: 'equirectangular' },
});
const destinationsMapSvg = map.getSVG({
  radius: 0.22,
  color: '#a9a9a9',
  shape: 'circle',
  backgroundColor: '#ffffff',
});
---

<section id="destinos" class="relative overflow-x-hidden bg-alabaster-50 py-20 lg:py-28">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-monza-200 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header data-reveal class="mb-10 max-w-2xl lg:mb-14">
      <h2 class="text-4xl font-extrabold tracking-tight text-cod-gray-950 sm:text-5xl lg:text-[3.25rem] lg:leading-[1.05]">
        Explora tu próximo destino
      </h2>
      <p class="mt-3 text-base leading-relaxed text-cod-gray-600 sm:text-lg">
        Consulta los itinerarios disponibles y descubre las experiencias que AVA Tours tiene preparadas
        para ti.
      </p>
    </header>

    <div data-reveal>
      <DestinationsPanel client:visible mapSvg={destinationsMapSvg} />
    </div>
  </div>
</section>

<style>
  #destinos dialog[data-lenis-prevent]::backdrop {
    background: rgb(10 10 10 / 0.72);
  }

  #destinos dialog[data-lenis-prevent]:not([open]) {
    display: none;
  }
</style>
